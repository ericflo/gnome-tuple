#!/bin/bash
# tuple-perf — one line of call performance, appended to a log.
#
# Video stutter on Linux can come from several places: Tuple decoding and
# drawing, the compositor (and XWayland, for Tuple's X11 windows), or the
# network/sender. The extension runs this every 20s during a call so there's
# evidence to look at afterwards:
#
#   time  tuple=%cpu  xwayland=%cpu  shell=%cpu  selfcam=%cpu  screen=WxH  webcams=WxH
#
# CPU is percent of one core over a 2s window. Window sizes come from the
# extension (Mutter knows them; nothing here can ask it).
# Usage: tuple-perf [log-file] [window sizes]
set -uo pipefail

out="${1:-}"
[ -n "$out" ] || out="${XDG_STATE_HOME:-$HOME/.local/state}/tuple-gnome/perf.log"
sizes="${2:-}"
mkdir -p "$(dirname "$out")"
hz=$(getconf CLK_TCK)

ticks() {  # utime+stime of a pid, or empty
  [ -n "$1" ] && [ -r "/proc/$1/stat" ] || return 0
  awk '{ sub(/^.*\) /, ""); print $12 + $13 }' "/proc/$1/stat"
}

declare -A pid=(
  [tuple]=$(pgrep -xo tuple)
  [xwayland]=$(pgrep -xo Xwayland)
  [shell]=$(pgrep -xo gnome-shell)
  [selfcam]=$(pgrep -o -f 'title=tuple-selfcam')
)
declare -A t0
for k in "${!pid[@]}"; do t0[$k]=$(ticks "${pid[$k]}"); done
sleep 2
line="$(date +%FT%T)"
for k in tuple xwayland shell selfcam; do
  t1=$(ticks "${pid[$k]}")
  if [ -n "${t0[$k]}" ] && [ -n "$t1" ]; then
    line+=" $k=$(( (t1 - t0[$k]) * 100 / (2 * hz) ))%"
  else
    line+=" $k=-"
  fi
done
line+=" ${sizes}"
echo "$line" >> "$out"
# Keep it from growing without bound.
if [ "$(wc -l < "$out")" -gt 5000 ]; then tail -n 4000 "$out" > "$out.tmp" && mv "$out.tmp" "$out"; fi
